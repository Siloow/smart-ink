# ---------------------------------------------------------------------------
# Beta gate. Set both and the app uses Supabase for waitlist, invites, and
# sign-in (Google or emailed code). Leave both empty in development and a
# browser-local demo gate is used instead; production builds without them
# disable sign-in. Setup: docs/supabase-setup.md
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Optional. Only used when Supabase is NOT configured: a hosted form endpoint
# that accepts JSON (Formspree, Tally, Basin, …) so landing-page requests
# still reach you. Without either, requests stay in the visitor's browser.
# VITE_WAITLIST_ENDPOINT=https://formspree.io/f/xxxxxxx

# Optional. Shown as a fallback address if a request cannot be delivered.
# VITE_CONTACT_EMAIL=

# Render server. Empty in dev means same-origin (Vite proxies to :8000).
# VITE_RENDER_URL=http://127.0.0.1:8000

# Optional dev-only override: use browser-local admin even with Supabase configured.
# VITE_AUTH_MODE=demo
